# Copie para .env e preencha localmente. Este arquivo não contém segredos.
DOMINIO=localhost
POSTGRES_DB=sora
POSTGRES_USER=sora
POSTGRES_PASSWORD=
DATABASE_URL=
PGHOST=postgres
PGPORT=5432
PGDATABASE=sora
PGUSER=sora
# Use PGPASSFILE apontando para um secret 0600; PGPASSWORD serve apenas para desenvolvimento.
PGPASSFILE=
PGPASSWORD=
REDIS_URL=redis://redis:6379/0
CHAVE_MESTRA=
# Rotação da chave mestra (detalhes em backend/.env.example): versão da atual (1 a 255) e
# chaves aposentadas só para decifrar, no formato "1:<base64>,2:<base64>".
CHAVE_MESTRA_VERSAO=1
CHAVES_MESTRAS_ANTIGAS=
JWT_SEGREDO=
BUSCA_PROVEDOR=tavily
BUSCA_CHAVE=
APP_URL=https://app.seu-dominio.com.br
# Em produção deixe vazio: o backend libera APP_URL + as origens do app de desktop (Tauri).
# Localhost só é aceito com AMBIENTE=desenvolvimento.
CORS_ORIGENS=
SENTRY_DSN=
SORA_MODELO_FALSO=0
AMBIENTE=producao
BACKUP_DIRETORIO=/backups
BACKUP_DESTINO_S3=
AGE_RECIPIENT=
SORA_RESTAURACAO_TESTE=0
DATABASE_URL_RESTAURACAO=
RESTAURACAO_PGHOST=postgres
RESTAURACAO_PGPORT=5432
RESTAURACAO_PGDATABASE=sora_restauracao_teste
RESTAURACAO_PGUSER=sora
RESTAURACAO_PGPASSFILE=
RESTAURACAO_PGPASSWORD=
# Peças adaptadas do Rakazo (docs/referencias/rakazo.md). Vazio = desligado.
TELEGRAM_TOKEN_BOT=
TELEGRAM_SEGREDO_WEBHOOK=
SANDBOX_PROVEDOR=nenhum
SANDBOX_IMAGEM=python:3.12-slim
SORA_MAX_SALTOS=
