# Backend da Sora: copie para `.env` e preencha. Nunca versione o `.env`.
#
# AMBIENTE: sem esta variável, a configuração vale `producao` (segura por padrão):
#   cookie de renovação `Secure`, modelo falso proibido, JWT_SEGREDO com 32+ bytes,
#   CORS sem localhost e nada de API de modelos na rede local.
#   No PC, use `desenvolvimento`. Os testes usam `teste` (tests/conftest.py).
AMBIENTE=desenvolvimento

DATABASE_URL=postgresql://sora:sora@localhost:5432/sora
REDIS_URL=redis://localhost:6379/0

# 32 bytes aleatórios em base64; cifra as chaves de API dos usuários. O boot falha se inválida.
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
CHAVE_MESTRA=
# Versão da CHAVE_MESTRA atual (1 a 255), gravada no 1º byte de cada segredo cifrado.
# Rotação: 1) mova a chave atual para CHAVES_MESTRAS_ANTIGAS ("1:<base64>"); 2) ponha a nova
# em CHAVE_MESTRA e suba a versão (2); 3) recifre as linhas com
# `app.core.seguranca.recifrar_segredo`; 4) só então tire a antiga da lista.
# As antigas só decifram; tudo é validado no boot (base64 de 32 bytes, versões únicas).
CHAVE_MESTRA_VERSAO=1
CHAVES_MESTRAS_ANTIGAS=

# Em produção: 32+ bytes aleatórios (o boot recusa valores curtos ou de exemplo).
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SEGREDO=

# Busca na web (tavily ou brave) e a chave da equipe.
# Só em desenvolvimento: searxng, duckduckgo (sem chave) ou falso.
BUSCA_PROVEDOR=tavily
BUSCA_CHAVE=

# Endereço do app e origens do CORS (vírgula). Vazio: Vite + Tauri fora de produção;
# em produção, APP_URL (se não for local) + Tauri. Localhost é recusado em produção.
APP_URL=http://localhost:5173
CORS_ORIGENS=

# API de modelos em localhost/rede privada (Ollama local, servidor na LAN).
# Vazio: liberado em desenvolvimento/teste, proibido em produção. Em produção só ligue
# se o servidor for auto-hospedado e a rede interna não tiver nada sensível.
PERMITIR_PROVEDOR_REDE_LOCAL=

# Volume dos anexos (relativo ao diretório de trabalho; /srv/sora/arquivos no contêiner).
PASTA_ARQUIVOS=arquivos

# Modelo falso (respostas prontas, sem chave). Só em desenvolvimento/teste: a API e o
# worker recusam subir com ele em produção.
SORA_MODELO_FALSO=0

SENTRY_DSN=

# --- Peças adaptadas do Rakazo (docs/referencias/rakazo.md) ---
# Canal Telegram: token do @BotFather e um segredo aleatório para o webhook. Vazio = desligado.
TELEGRAM_TOKEN_BOT=
TELEGRAM_SEGREDO_WEBHOOK=
# executar_comando: nenhum (desligado) ou docker (contêiner descartável; veja os avisos no doc).
SANDBOX_PROVEDOR=nenhum
SANDBOX_IMAGEM=python:3.12-slim
# Trocas seguidas entre agentes sem o usuário antes de recusar a entrega (padrão 6).
SORA_MAX_SALTOS=
